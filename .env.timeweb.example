# Domain and server
SERVER_DOMAIN=example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=example.com
TURN_USER=turnuser
TURN_PASS=turnpass
TURN_CLI_PASSWORD=turncli
VITE_TURN_URL=turn:example.com:3478?transport=udp,turn:example.com:3478?transport=tcp
VITE_TURN_USER=turnuser
VITE_TURN_PASS=turnpass

# Database
POSTGRES_DB=psychology_db
POSTGRES_USER=psychology_user
POSTGRES_PASSWORD=change_me_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# App profile
APP_SEED_ENABLED=false
APP_ORGANIZATION_NAME=ООО «Телеком без границ»
APP_PSYCHOLOGISTS_REQUIRE_VERIFICATION=false

# Telegram OTP (optional)
APP_TELEGRAM_ENABLED=false
APP_TELEGRAM_BOT_TOKEN=
APP_TELEGRAM_POLLING_ENABLED=true
APP_TELEGRAM_POLLING_FIXED_DELAY_MS=5000

# Email OTP (SMTP)
APP_EMAIL_OTP_ENABLED=true
APP_EMAIL_OTP_FROM=tbgpsychology@gmail.com
APP_EMAIL_OTP_SUBJECT=Код входа в платформу
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tbgpsychology@gmail.com
SPRING_MAIL_PASSWORD=change_me_gmail_app_password_without_spaces
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=10000

# Optional SMTP fallback via host proxy (useful when provider blocks direct 587/465 from Docker)
# Example host service:
#   socat TCP-LISTEN:1465,reuseaddr,fork OPENSSL:smtp.gmail.com:465,verify=0
APP_EMAIL_OTP_FALLBACK_HOST=host.docker.internal
APP_EMAIL_OTP_FALLBACK_PORT=1465
APP_EMAIL_OTP_FALLBACK_AUTH=true
APP_EMAIL_OTP_FALLBACK_STARTTLS_ENABLE=false
APP_EMAIL_OTP_FALLBACK_STARTTLS_REQUIRED=false
APP_EMAIL_OTP_FALLBACK_SSL_ENABLE=false
APP_EMAIL_OTP_FALLBACK_SSL_TRUST=

# Cleaner production logs
SPRING_JPA_SHOW_SQL=false
SPRING_DATA_REDIS_REPOSITORIES_ENABLED=false

# Optional JVM network tuning (useful if provider has IPv6 quirks)
JAVA_OPTS=-Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false
