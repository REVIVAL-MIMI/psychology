# Domain and server
SERVER_DOMAIN=example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=example.com
TURN_USER=turnuser
TURN_PASS=turnpass
TURN_CLI_PASSWORD=turncli
VITE_TURN_URL=turn:example.com:3478?transport=udp,turn:example.com:3478?transport=tcp
VITE_TURN_USER=turnuser
VITE_TURN_PASS=turnpass

# Database
POSTGRES_DB=psychology_db
POSTGRES_USER=psychology_user
POSTGRES_PASSWORD=change_me_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# App profile
APP_SEED_ENABLED=false
APP_ORGANIZATION_NAME=ООО «Телеком без границ»
APP_PSYCHOLOGISTS_REQUIRE_VERIFICATION=false

# Telegram OTP (optional)
APP_TELEGRAM_ENABLED=false
APP_TELEGRAM_BOT_TOKEN=
APP_TELEGRAM_POLLING_ENABLED=true
APP_TELEGRAM_POLLING_FIXED_DELAY_MS=5000

# Email OTP (recommended for Timeweb: domain mailbox)
APP_EMAIL_OTP_ENABLED=true
APP_EMAIL_OTP_FROM=no-reply@example.com
APP_EMAIL_OTP_SUBJECT=Код входа в платформу
SPRING_MAIL_HOST=smtp.timeweb.ru
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=no-reply@example.com
SPRING_MAIL_PASSWORD=CHANGE_ME_MAILBOX_PASSWORD
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=smtp.timeweb.ru
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=10000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=10000

# Optional JVM network tuning (useful if provider has IPv6 quirks)
JAVA_OPTS=-Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false
